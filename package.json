{
  "name": "bookstore-microservices",
  "version": "0.0.1",
  "description": "A learning-first NestJS bookstore built with TCP microservices.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm build:api-gateway && pnpm build:users && pnpm build:books && pnpm build:orders && pnpm build:notifications",
    "build:api-gateway": "nest build api-gateway",
    "build:users": "nest build users-service",
    "build:books": "nest build books-service",
    "build:orders": "nest build orders-service",
    "build:notifications": "nest build notifications-service",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down",
    "docker:seed": "docker compose run --rm migrations node -r ts-node/register -r tsconfig-paths/register database/seeds/seed.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d database/data-source.ts -p",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d database/data-source.ts",
    "seed": "node -r ts-node/register -r tsconfig-paths/register database/seeds/seed.ts",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"database/**/*.ts\"",
    "start:gateway": "nest start api-gateway --watch",
    "start:users": "nest start users-service --watch",
    "start:books": "nest start books-service --watch",
    "start:orders": "nest start orders-service --watch",
    "start:notifications": "nest start notifications-service --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1"
    }
  }
}
